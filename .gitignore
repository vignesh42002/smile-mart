# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare / open-next
.open-next/
.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# local JSON "database" — contains lead PII and the admin password hash.
# Seed content (categories, business models, faqs, businessNetwork) is safe
# to commit; these runtime-written files are not.
/data/leads.json
/data/admins.json
/data/events.log

# admin-uploaded images (stub for cloud storage — see README)
/public/uploads/
