{
  "name": "smile-mart-india",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare",
    "cf:deploy": "opennextjs-cloudflare && wrangler deploy",
    "cf:deploy:website": "opennextjs-cloudflare && wrangler deploy -c wrangler.website.jsonc",
    "cf:deploy:admin": "opennextjs-cloudflare && wrangler deploy -c wrangler.admin.jsonc",
    "pages:build": "next-on-pages",
    "pages:deploy": "next-on-pages && wrangler pages deploy .vercel/output/static",
    "pages:deploy:website": "next-on-pages && wrangler pages deploy .vercel/output/static --project-name smile-mart-website",
    "pages:deploy:admin": "next-on-pages && wrangler pages deploy .vercel/output/static --project-name smile-mart-admin"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@opennextjs/cloudflare": "^1.20.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.127.1"
  }
}
